// ============================================================================
// src/vesa.rs — вывод на framebuffer (через Limine).
//
// 2026-08-22: мёртвый код (VBE BIOS инициализация, vesa_init, vbe_call,
// VbeControllerInfo, VbeModeInfo, vesa_draw_char, vesa_print_str, VesaWriter,
// vesa_scroll_screen, vesa_put_pixel, vesa_get_width/height) перенесён
// в arhiv/src_bak/vesa_old.bak. Limine даёт framebuffer напрямую — VBE BIOS
// не нужен.
//
// Живой код: vesa_set_framebuffer, vesa_clear_screen, vesa_draw_char_ex,
// FONT_DATA, FONT_WIDTH/HEIGHT, VESA_FRAMEBUFFER/PITCH/WIDTH/HEIGHT.
// ============================================================================

// --- Глобальные statics для framebuffer (заполняются vesa_set_framebuffer) ---

static mut VESA_FRAMEBUFFER: *mut u32 = 0 as *mut u32;
static mut VESA_PITCH: u16 = 0;
static mut VESA_WIDTH: u16 = 0;
static mut VESA_HEIGHT: u16 = 0;

/// Устанавливает framebuffer, полученный от Limine (не через VBE BIOS).
/// Заполняет глобальные static'ы, которые использует vesa_draw_char_ex
/// и vesa_clear_screen.
/// pitch/width/height передаются как u32 (из Limine они u64).
pub fn vesa_set_framebuffer(addr: *mut u32, pitch: u32, width: u32, height: u32) {
    unsafe {
        VESA_FRAMEBUFFER = addr;
        VESA_PITCH = pitch as u16;
        VESA_WIDTH = width as u16;
        VESA_HEIGHT = height as u16;
    }
}

// --- Шрифт 8x16 (только ASCII 32-126) ---

