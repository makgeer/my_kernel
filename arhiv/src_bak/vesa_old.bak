pub const VBE_FUNCTION_GET_CONTROLLER_INFO: u8 = 0x4f;
pub const VBE_FUNCTION_GET_MODE_INFO: u8 = 0x4f;
pub const VBE_FUNCTION_SET_MODE: u8 = 0x4f;
pub const VBE_GET_CONTROLLER_INFO: u16 = 0x00;
#[allow(dead_code)]
pub const VBE_GET_MODE_INFO: u16 = 0x01;
#[allow(dead_code)]
pub const VBE_SET_MODE: u16 = 0x02;
#[allow(dead_code)]
pub const VBE_MODE_ATTRIBUTE: u16 = 0x9000; // LFB, memory model, graphics, supported

// VESA mode for 1280x800x32 (обычно 0x0105 или 0x010D - зависит от реализации)
#[allow(non_upper_case_globals)]
pub const VESA_MODE_1280x800x32: u16 = 0x0105;

