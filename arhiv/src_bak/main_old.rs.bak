#![no_std]
#![no_main]
#![allow(static_mut_refs)]

use core::panic::PanicInfo;
use core::fmt::Write;

mod vesa;

const VGA_WIDTH: usize = 80;
const VGA_HEIGHT: usize = 25;
const VGA_COLOR: u8 = 0x0f;
const VGA_BUFFER: u64 = 0xb8000;

struct Terminal {
    row: usize,
    col: usize,
    buffer: *mut u8,
}

impl Terminal {
    fn write_char(&mut self, c: char) {
        match c {
            '\n' => {
                self.row += 1;
                self.col = 0;
                if self.row >= VGA_HEIGHT {
                    self.scroll();
                }
            }
            '\r' => {
                self.col = 0;
            }
            c => {
                if self.col >= VGA_WIDTH {
                    self.col = 0;
                    self.row += 1;
                    if self.row >= VGA_HEIGHT {
                        self.scroll();
                    }
                }
                let pos = (self.row * VGA_WIDTH + self.col) * 2;
                unsafe {
                    *self.buffer.offset(pos as isize) = c as u8;
                    *self.buffer.offset(pos as isize + 1) = VGA_COLOR;
                }
                self.col += 1;
            }
        }
    }

    fn write_str(&mut self, s: &str) {
        for c in s.chars() {
            self.write_char(c);
        }
    }

    fn scroll(&mut self) {
        unsafe {
            let src = self.buffer.offset((VGA_WIDTH * 2) as isize);
            let dst = self.buffer;
            core::ptr::copy(src, dst, VGA_WIDTH * (VGA_HEIGHT - 1) * 2);
            let last = self.buffer.offset((VGA_WIDTH * (VGA_HEIGHT - 1) * 2) as isize);
            core::ptr::write_bytes(last, 0, VGA_WIDTH * 2);
        }
        self.row = VGA_HEIGHT - 1;
        self.col = 0;
    }

    fn clear(&mut self) {
        unsafe {
            core::ptr::write_bytes(self.buffer, 0, VGA_WIDTH * VGA_HEIGHT * 2);
        }
        self.row = 0;
        self.col = 0;
    }
}

impl Write for Terminal {
    fn write_str(&mut self, s: &str) -> core::fmt::Result {
        for c in s.chars() {
            self.write_char(c);
        }
        Ok(())
    }
}

static mut TERMINAL: Terminal = Terminal {
    row: 0,
    col: 0,
    buffer: VGA_BUFFER as *mut u8,
};

fn print(s: &str) {
    unsafe {
        let _ = TERMINAL.write_str(s);
    }
}

fn println(s: &str) {
    print(s);
    print("\n");
}

// ТОЧКА ВХОДА ИЗ ASSEMBLY
#[no_mangle]
pub extern "C" fn _start_rust() -> ! {
    // Инициализация VESA графического режима
    let vesa_ok = unsafe { vesa::vesa_init() };
    
    if vesa_ok {
        println!("VESA: OK (1280x800x32)");
        unsafe {
            vesa::vesa_clear_screen(0x001122FF); // Синий цвет
        }
    } else {
        println!("VESA: Failed, fallback to VGA");
        unsafe {
            TERMINAL.clear();
        }
}

#[panic_handler]
fn panic(_info: &PanicInfo) -> ! {
    println!("\n!!! PANIC !!!");
    loop {
        unsafe {
            core::arch::asm!("hlt");
        }
    }
}
