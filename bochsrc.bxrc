# Bochs configuration for malinka (режим term-дисплея)
# Ядро собрано без framebuffer (no-fb): Limine не запрашивает 32bpp
# графический режим, term-дисплей (ncurses) не падает.
# Ввод: PS/2-клавиатура от term-дисплея (IRQ1).
# Вывод: VGA text buffer 80x25 на term-дисплей + serial в файл.
# Запуск: ./bochs-bin/bin/bochs -q -f bochsrc.bxrc
# (iso должен быть собран: make_iso.sh no-fb или cargo build --release --no-default-features)

# Память 512 MB
megs: 512

# Boot с CD-ROM
boot: cdrom

# VGA — стандартный текстовый режим (без VBE!)
# extension=vbe включает VBE BIOS: Limine при загрузке переключает
# в графический 32bpp режим даже без FramebufferRequest от ядра.
# term-дисплей (ncurses) поддерживает только текстовый 80x25.
# Без extension=vbe Bochs остаётся в текстовом режиме — term работает.
vga: extension=none

# ROM images — стандартные BIOS Bochs
romimage: file=/usr/local/share/bochs/BIOS-bochs-latest
vgaromimage: file=/usr/local/share/bochs/VGABIOS-lgpl-latest

# CD-ROM на ATA канале 0
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=cdrom, path="boot.iso", status=inserted

# Serial COM1 → файл (лог ядра через serial)
# Ввод идёт через PS/2-клавиатуру от term-дисплея.
com1: enabled=1, mode=file, dev="bochs_serial.log"

# Display library — term (ncurses-терминал)
# Показывает VGA text buffer 80x25, клавиатура → PS/2 скан-коды.
display_library: term

# CPU — bx_generic с x86_64
cpu: count=1, ips=40000000, model=bx_generic, reset_on_triple_fault=0

# CPUID — включаем x86_64 и необходимые расширения
cpuid: x86_64=1, mmx=1, sep=1, simd=sse4_2, apic=xapic, aes=1, movbe=1, xsave=1

# Лог Bochs
log: bochs.log
