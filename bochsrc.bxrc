# Bochs configuration for malinka (стабильный режим nogui + VBE + socket)
# Это ГАРАНТИРОВАННО РАБОЧАЯ конфигурация (подтверждено 2026-08-17):
#   - nogui: нет графического дисплея, нет падений term/VBE
#   - extension=vbe: Limine корректно инициализирует framebuffer
#   - ISO собран с fb (FramebufferRequest включён)
#   - com1: mode=socket-server — интерактивный ввод/вывод через nc
#
# Запуск (два терминала):
#   Терминал 1: ./bochs-bin/bin/bochs -q -f bochsrc.bxrc
#   Терминал 2: nc localhost 8888
#
# В nc виден весь serial-вывод ядра, ввод с клавиатуры → COM1 → shell.
# Дополнительно лог пишется в bochs_serial.log (через log-опцию com1).

# Память 512 MB
megs: 512

# Boot с CD-ROM
boot: cdrom

# VGA — VBE включён (Limine требует VBE для framebuffer)
vga: extension=vbe

# ROM images — стандартные BIOS Bochs
romimage: file=/usr/local/share/bochs/BIOS-bochs-latest
vgaromimage: file=/usr/local/share/bochs/VGABIOS-lgpl-latest

# CD-ROM на ATA канале 0
ata0: enabled=1, ioaddr1=0x1f0, ioaddr2=0x3f0, irq=14
ata0-master: type=cdrom, path="boot.iso", status=inserted

# Btrfs-диск на ATA канале 1 (secondary, 0x170)
ata1: enabled=1, ioaddr1=0x170, ioaddr2=0x370, irq=15
ata1-master: type=disk, path="btrfs.img", mode=flat

# Serial COM1 — socket-server для интерактивного ввода/вывода.
# Bochs слушает порт 8888, подключение через: nc localhost 8888
# Вывод ядра (serial) идёт в сокет → виден в nc.
# Ввод с клавиатуры в nc → COM1 → ядро (shell read_line через getchar).
com1: enabled=1, mode=socket-server, dev=localhost:8888

# Display library — nogui (headless, без дисплея).
# Стабильный режим: не падает, не требует X11/ncurses.
# Весь ввод/вывод — через serial (socket-server).
display_library: nogui

# CPU — pentium с x86_64 (исправлено с bx_generic для Bochs 3.1)
cpu: count=1, ips=40000000, model=pentium, reset_on_triple_fault=0

# CPUID — включаем x86_64 и необходимые расширения
# Примечание: в Bochs 3.1 legacy cpuid может не поддерживаться — если ошибка, закомментируй
# cpuid: x86_64=1, mmx=1, sep=1, simd=sse4_2, apic=xapic, aes=1, movbe=1, xsave=1

# Лог Bochs
log: bochs.log
